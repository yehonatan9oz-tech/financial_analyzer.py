        ("P/E Ratio (TTM)",    _ov("PERatio")),
        ("Forward P/E",        _ov("ForwardPE")),
        ("EPS (TTM, $)",       _ov("EPS")),
        ("Dividend Yield",     _ov("DividendYield")),
    ]
    for i, (kpi_lbl, kpi_val) in enumerate(kpis):
        ws.write(4, i + 1, kpi_lbl, fmt["dash_kpi_lbl"])
        ws.write(5, i + 1, kpi_val, fmt["dash_kpi_val"])

    ws.set_row(6, 8)
    ws.set_row(7, 16)
    ws.set_row(8, 85)
    ws.merge_range("B8:G8",  "Business Overview",               fmt["sub_hdr"])
    ws.merge_range("B9:G9",  overview.get("Description", "—"),  fmt["dash_desc"])

    ws.set_row(9,  8)
    ws.set_row(10, 16)
    ws.set_row(11, 16)
    ws.set_row(12, 44)
    ws.merge_range("B11:G11", "5-Year Financial Trends  (USD Millions)", fmt["sub_hdr"])

    SPARK_BASE = 100

    spark_specs = [
        ("Revenue",        "totalRevenue",  df_inc_a, 1),
        ("Net Income",     "netIncome",     df_inc_a, 2),
        ("Free Cash Flow", "freeCashFlow",  df_cf_a,  3),
    ]

    for spark_label, metric_key, src_df, col_idx in spark_specs:
        ws.write(11, col_idx, spark_label, fmt["dash_spark_lbl"])

        if src_df.empty or metric_key not in src_df.index:
            continue

        vals = src_df.loc[metric_key].dropna().tolist()[-5:]
        if not vals:
            continue

        data_row = SPARK_BASE + col_idx
        for j, v in enumerate(vals):
            ws.write(data_row, j, v)

        last_col = chr(ord("A") + len(vals) - 1)
        ws.add_sparkline(
            12, col_idx,
            {
                "range":            f"Dashboard!A{data_row + 1}:{last_col}{data_row + 1}",
                "type":             "line",
                "markers":          True,
                "high_point":       True,
                "low_point":        True,
                "series_color":     C["mid_blue"],
                "markers_color":    C["dark_blue"],
                "high_point_color": C["pos_green"],
                "low_point_color":  C["neg_red"],
            },
        )

    ws.set_row(13, 8)
    ws.set_row(14, 16)
    ws.merge_range("B15:G15", "Key Investment Highlights", fmt["sub_hdr"])

    def _shares(key: str) -> str:
        v = float(overview.get(key) or 0)
        return f"{v / 1e6:.0f}M" if v else "—"

    highlights = [
        f"Fiscal Year End: {_ov('FiscalYearEnd')}   |   CIK: {_ov('CIK')}",
        f"Analyst Target Price: {_ov('AnalystTargetPrice')}   |   Beta: {_ov('Beta')}",
        f"52-Week Range: {_ov('52WeekLow')} – {_ov('52WeekHigh')}",
        f"PEG Ratio: {_ov('PEGRatio')}   |   Book Value / Share: {_ov('BookValue')}",
        f"Shares Outstanding: {_shares('SharesOutstanding')}   |   "
        f"Float: {_shares('SharesFloat')}",
    ]
    for k, hl in enumerate(highlights):
        r = 15 + k
        ws.set_row(r, 15)
        ws.merge_range(r, 1, r, 6, hl, fmt["dash_highlight"])


