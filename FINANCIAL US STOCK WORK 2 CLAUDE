def process_raw_reports(
    reports: List[Dict[str, Any]],
    divide_by_million: bool = True,
) -> pd.DataFrame:
    if not reports:
        return pd.DataFrame()
    df = pd.DataFrame(reports)
    if "fiscalDateEnding" not in df.columns:
        return pd.DataFrame()
    df = df.set_index("fiscalDateEnding").transpose()
    for col in df.columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    if divide_by_million:
        df /= 1_000_000
    return df[sorted(df.columns)]


def calculate_financial_metrics(
    df_inc: pd.DataFrame,
    df_bal: pd.DataFrame,
    df_cf: pd.DataFrame,
) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:
    # Free Cash Flow
    if not df_cf.empty:
        cfo   = df_cf.loc["operatingCashflow"]   if "operatingCashflow"   in df_cf.index else None
        capex = df_cf.loc["capitalExpenditures"]  if "capitalExpenditures" in df_cf.index else None
        if cfo is not None and capex is not None:
            df_cf.loc["freeCashFlow"] = cfo + capex
        elif cfo is not None:
            df_cf.loc["freeCashFlow"] = cfo

    # EPS
    if not df_inc.empty:
        ni     = df_inc.loc["netIncome"]                   if "netIncome"                   in df_inc.index else None
        shares = df_inc.loc["commonStockSharesOutstanding"] if "commonStockSharesOutstanding" in df_inc.index else None
        if ni is not None and shares is not None:
            df_inc.loc["earningsPerShare"] = ni / shares.replace(0, float("nan"))

    # Margin ratios (decimal)
    if not df_inc.empty and "totalRevenue" in df_inc.index:
        rev = df_inc.loc["totalRevenue"].replace(0, float("nan"))
        for metric, key in [
            ("grossProfit",    "_gross_margin"),
            ("operatingIncome","_operating_margin"),
            ("netIncome",      "_net_margin"),
        ]:
            if metric in df_inc.index:
                df_inc.loc[key] = df_inc.loc[metric] / rev

        if not df_cf.empty and "freeCashFlow" in df_cf.index:
            common = df_inc.columns.intersection(df_cf.columns)
            if len(common):
                margin = df_cf.loc["freeCashFlow", common] / rev[common]
                df_inc.loc["_fcf_margin", common] = margin
                df_cf.loc["_fcf_margin",  common] = margin

    # YoY growth rates
    if not df_inc.empty and len(df_inc.columns) > 1:
        for metric, key in [
            ("totalRevenue",    "_rev_yoy"),
            ("operatingIncome", "_opinc_yoy"),
            ("netIncome",       "_ni_yoy"),
        ]:
            if metric in df_inc.index:
                df_inc.loc[key] = df_inc.loc[metric].pct_change()

    return df_inc, df_bal, df_cf


def calculate_valuation_metrics(
    df_inc: pd.DataFrame,
    df_bal: pd.DataFrame,
    df_cf: pd.DataFrame,
    overview: Dict[str, Any],
) -> pd.DataFrame:
    mkt_cap = float(overview.get("MarketCapitalization") or 0) / 1_000_000
    rows: Dict[str, Dict[str, Optional[float]]] = {}

    for col in (df_inc.columns if not df_inc.empty else []):

        def g(df: pd.DataFrame, key: str, _col: str = col) -> float:
            if df.empty or key not in df.index or _col not in df.columns:
                return 0.0
            v = df.at[key, _col]
            return float(v) if pd.notna(v) else 0.0

        rev     = g(df_inc, "totalRevenue")
        gp      = g(df_inc, "grossProfit")
        ebit    = g(df_inc, "operatingIncome")
        ebitda  = g(df_inc, "ebitda")
        ebt     = g(df_inc, "incomeBeforeTax")
        tax     = g(df_inc, "incomeTaxExpense")
        ni      = g(df_inc, "netIncome")
        int_exp = abs(g(df_inc, "interestExpense"))

        ta      = g(df_bal, "totalAssets")
        te      = g(df_bal, "totalShareholderEquity")
        ca      = g(df_bal, "totalCurrentAssets")
        cl      = g(df_bal, "totalCurrentLiabilities")
        debt    = g(df_bal, "shortLongTermDebtTotal")
        cash    = (g(df_bal, "cashAndCashEquivalentsAtCarryingValue")
                   or g(df_bal, "cashAndShortTermInvestments"))
        inv     = g(df_bal, "inventory")

        cfo     = g(df_cf, "operatingCashflow")
        fcf     = g(df_cf, "freeCashFlow")

        tax_rate  = (tax / ebt) if ebt > 0 and tax >= 0 else 0.0
        nopat     = ebit * (1.0 - tax_rate)
        inv_cap   = te + debt - cash
        ev        = mkt_cap + debt - cash

        def safe(n: float, d: float) -> Optional[float]:
            return (n / d) if d and pd.notna(n) and pd.notna(d) else None

        r: Dict[str, Optional[float]] = {
            "Gross Margin %":         safe(gp,    rev),
            "Operating Margin %":     safe(ebit,  rev),
            "Net Margin %":           safe(ni,    rev),
            "EBITDA Margin %":        safe(ebitda, rev),
            "FCF Margin %":           safe(fcf,   rev),
            "ROIC %  (NOPAT / Invested Capital)": safe(nopat, inv_cap),
            "ROE %  (Net Income / Equity)":       safe(ni,    te),
            "ROA %  (Net Income / Total Assets)": safe(ni,    ta),
            "ROCE %  (EBIT / Capital Employed)":  safe(ebit,  ta - cl) if (ta - cl) else None,
            "Current Ratio": safe(ca,          cl),
            "Quick Ratio":   safe(ca - inv,    cl),
            "Debt / Equity":         safe(debt,      te),
            "Net Debt / EBITDA":     safe(debt - cash, ebitda),
            "Interest Coverage (x)": safe(ebit,      int_exp),
            "CFO / Net Income":               safe(cfo, ni),
            "FCF / CFO":                      safe(fcf, cfo),
            "FCF Yield %  [vs. Current Mkt Cap]": safe(fcf, mkt_cap),
            "P/E  [Curr. Mkt Cap / Hist. Net Income]": safe(mkt_cap, ni)     if ni     > 0 else None,
            "P/S  [Curr. Mkt Cap / Hist. Revenue]":    safe(mkt_cap, rev)    if rev    > 0 else None,
            "P/B  [Curr. Mkt Cap / Hist. Book Value]": safe(mkt_cap, te)     if te     > 0 else None,
            "EV/EBITDA  [Curr. EV / Hist. EBITDA]":    safe(ev,      ebitda) if ebitda > 0 else None,
        }
        rows[col] = r

    df_out = pd.DataFrame(rows).T
    df_out.index.name = "Period"
    return df_out


