def fetch_api_data(url: str, label: str) -> Optional[Dict[str, Any]]:
    try:
        resp = requests.get(url, timeout=30)
        resp.raise_for_status()
        data: Dict[str, Any] = resp.json()

        if "Error Message" in data:
            print(f"  [ERROR]      {label}: {data['Error Message']}")
            return None
        if "Note" in data:
            print(f"  [RATE LIMIT] {label}: API call frequency exceeded.")
            print("  Upgrade to a paid Alpha Vantage plan or wait 60 s.")
            return None
        if "Information" in data:
            print(f"  [INFO]       {label}: {data['Information']}")
            return None
        return data

    except requests.exceptions.Timeout:
        print(f"  [TIMEOUT]    {label}")
        return None
    except requests.exceptions.RequestException as exc:
        print(f"  [ERROR]      {label}: {exc}")
        return None


def fetch_all_financial_data(ticker: str, api_key: str) -> Dict[str, Any]:
    endpoints = [
        ("income",   f"{API_BASE_URL}?function=INCOME_STATEMENT&symbol={ticker}&apikey={api_key}"),
        ("balance",  f"{API_BASE_URL}?function=BALANCE_SHEET&symbol={ticker}&apikey={api_key}"),
        ("cashflow", f"{API_BASE_URL}?function=CASH_FLOW&symbol={ticker}&apikey={api_key}"),
        ("overview", f"{API_BASE_URL}?function=OVERVIEW&symbol={ticker}&apikey={api_key}"),
    ]
    results: Dict[str, Any] = {}
    for i, (key, url) in enumerate(endpoints):
        print(f"  [{i + 1}/4] Fetching {key.capitalize()}...")
        results[key] = fetch_api_data(url, key)
        if i < len(endpoints) - 1:
            time.sleep(API_DELAY_SEC)
    return results


