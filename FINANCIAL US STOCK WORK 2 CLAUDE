def format_excel_dashboard(
    wb:       xlsxwriter.Workbook,
    ws:       Any,
    ticker:   str,
    overview: Dict[str, Any],
    df_inc_a: pd.DataFrame,
    df_cf_a:  pd.DataFrame,
    fmt:      Dict[str, Any],
) -> None:
    ws.hide_gridlines(2)
    ws.set_zoom(90)

    ws.set_column("A:A", 2)
    ws.set_column("B:G", 16)
    ws.set_column("H:H", 3)
    ws.set_column("I:J", 30)

    name     = overview.get("Name",     ticker)
    exchange = overview.get("Exchange", "")
    sector   = overview.get("Sector",   "")
    industry = overview.get("Industry", "")

    ws.set_row(0, 8)
    ws.set_row(1, 36)
    ws.merge_range("B2:G2", f"{name}  ({ticker})   ·   {exchange}", fmt["dash_title"])
    ws.set_row(2, 16)
    ws.merge_range("B3:G3", f"{sector}   |   {industry}", fmt["dash_sub"])

    ws.set_row(3, 8)
    ws.set_row(4, 18)
    ws.set_row(5, 22)

    mkt_cap_raw = float(overview.get("MarketCapitalization") or 0)
    if mkt_cap_raw >= 1e9:
        mkt_cap_str = f"${mkt_cap_raw / 1e9:.1f}B"
    elif mkt_cap_raw > 0:
        mkt_cap_str = f"${mkt_cap_raw / 1e6:.0f}M"
    else:
        mkt_cap_str = "—"

    def _ov(key: str) -> str:
