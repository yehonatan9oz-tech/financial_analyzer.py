def build_labeled_df(
    df: pd.DataFrame,
    order: List[str],
    labels: Dict[str, str],
    extra: Optional[pd.DataFrame] = None,
    extra_key: str = "_fcf_margin",
) -> pd.DataFrame:
    src = df.copy()
    if extra is not None and extra_key in extra.index and extra_key not in src.index:
        src.loc[extra_key] = extra.loc[extra_key]
    present = [k for k in order if k in src.index]
    result  = src.reindex(present)
    result.index = [labels[k] for k in present]
    return result


