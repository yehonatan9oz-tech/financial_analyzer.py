# 14. Helper to clean data
def clean_dataframe_for_excel(df):
    """Replace NaN and Inf with empty strings or 0"""
    df = df.copy()
    df = df.replace([np.inf, -np.inf], np.nan)
    df = df.fillna('')
    return df

# 15. Create Excel with all sheets
def create_formatted_excel(ticker, income_statement, balance_sheet, cashflow_statement,
                          quarterly_income, quarterly_balance, quarterly_cashflow, ratios_df):
    output_file = f"{ticker}_financial_report.xlsx"
    
    # Clean data
    income_statement_clean = clean_dataframe_for_excel(income_statement)
    balance_sheet_clean = clean_dataframe_for_excel(balance_sheet)
    cashflow_statement_clean = clean_dataframe_for_excel(cashflow_statement)
    quarterly_income_clean = clean_dataframe_for_excel(quarterly_income)
    quarterly_balance_clean = clean_dataframe_for_excel(quarterly_balance)
    quarterly_cashflow_clean = clean_dataframe_for_excel(quarterly_cashflow)
    ratios_df_clean = clean_dataframe_for_excel(ratios_df)
    
    with pd.ExcelWriter(output_file, engine='xlsxwriter') as writer:
        workbook = writer.book
        
        # Formats
        header_format = workbook.add_format({
            'bold': True,
            'bg_color': '#1F4788',
            'font_color': 'white',
            'border': 1,
            'align': 'center',
        })
        
        important_format = workbook.add_format({
            'bold': True,
            'bg_color': '#FFD966',
            'border': 1,
            'num_format': '#,##0',
        })
        
        important_eps_format = workbook.add_format({
            'bold': True,
            'bg_color': '#FFD966',
            'border': 1,
            'num_format': '#,##0.00',
        })
        
        normal_format = workbook.add_format({
            'border': 1,
            'num_format': '#,##0',
        })
        
        # Important rows
        important_income_rows = {
            'totalRevenue', 'grossProfit', 'operatingIncome', 
            'netIncome', 'earningsPerShare', 'ebitda'
        }
        
        important_balance_rows = {
            'totalCurrentAssets', 'totalAssets', 'totalCurrentLiabilities',
            'totalLiabilities', 'totalShareholderEquity'
        }
        
        important_cashflow_rows = {
            'operatingCashflow', 'capitalExpenditures', 'cashflowFromFinancing'
        }
        
        # Write sheets
        income_statement_clean.to_excel(writer, sheet_name='Income Statement')
        balance_sheet_clean.to_excel(writer, sheet_name='Balance Sheet')
        cashflow_statement_clean.to_excel(writer, sheet_name='Cash Flow')
        
        if not quarterly_income_clean.empty:
            quarterly_income_clean.to_excel(writer, sheet_name='Quarterly Income')
        if not quarterly_balance_clean.empty:
            quarterly_balance_clean.to_excel(writer, sheet_name='Quarterly Balance')
        if not quarterly_cashflow_clean.empty:
            quarterly_cashflow_clean.to_excel(writer, sheet_name='Quarterly Cash Flow')
        
        ratios_df_clean.to_excel(writer, sheet_name='Financial Ratios')
        
        # Format all sheets
        for sheet_name in writer.sheets:
            ws = writer.sheets[sheet_name]
            ws.set_column('A:A', 40)
            ws.set_column('B:Z', 16)
    
    return output_file

