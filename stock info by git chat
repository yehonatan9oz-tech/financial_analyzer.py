# 8. Helper function to calculate missing metrics
def calculate_derived_metrics(df_income, df_balance, df_cashflow):
    """Calculate metrics that may not be directly available"""
    derived = pd.DataFrame()
    
    # Free Cash Flow = Operating Cash Flow - CapEx
    if 'operatingCashflow' in df_cashflow.index and 'capitalExpenditures' in df_cashflow.index:
        ocf = df_cashflow.loc['operatingCashflow']
        capex = df_cashflow.loc['capitalExpenditures'].abs()
        derived.loc['freeCAshflow'] = ocf - capex
    
    # EBIT = Operating Income (already in data)
    if 'operatingIncome' in df_income.index:
        derived.loc['ebit'] = df_income.loc['operatingIncome']
    
    # Gross Margin % 
    if 'grossProfit' in df_income.index and 'totalRevenue' in df_income.index:
        revenue = df_income.loc['totalRevenue']
        gross_profit = df_income.loc['grossProfit']
        derived.loc['grossMarginPercent'] = (gross_profit / revenue * 100)
    
    # Operating Margin %
    if 'operatingIncome' in df_income.index and 'totalRevenue' in df_income.index:
        revenue = df_income.loc['totalRevenue']
        op_income = df_income.loc['operatingIncome']
        derived.loc['operatingMarginPercent'] = (op_income / revenue * 100)
    
    # Net Profit Margin %
    if 'netIncome' in df_income.index and 'totalRevenue' in df_income.index:
        revenue = df_income.loc['totalRevenue']
        net_income = df_income.loc['netIncome']
        derived.loc['netMarginPercent'] = (net_income / revenue * 100)
    
    return derived

# 9. Functions to arrange statements
def arrange_income_statement(df_income, df_cashflow):
    combined = pd.concat([df_income, df_cashflow])
    combined = combined[~combined.index.duplicated(keep='first')]
    
    existing_rows = [r for r in income_statement_order if r in combined.index]
    other_rows = [r for r in combined.index if r not in income_statement_order]
    
    final_df = combined.reindex(existing_rows + other_rows)
    
    # Add EPS calculation if missing
    if 'commonStockSharesOutstanding' in final_df.index and 'netIncome' in final_df.index and 'earningsPerShare' not in final_df.index:
        eps_values = {}
        for col in final_df.columns:
            shares = final_df.loc['commonStockSharesOutstanding', col]
            net_income = final_df.loc['netIncome', col]
            if pd.notna(shares) and pd.notna(net_income) and shares > 0:
                eps_values[col] = net_income / shares
            else:
                eps_values[col] = None
        
        eps_series = pd.Series(eps_values, name='earningsPerShare')
        final_df = pd.concat([final_df, eps_series.to_frame().T])
    
    return final_df

def arrange_balance_sheet(df_balance):
    existing_rows = [r for r in balance_sheet_order if r in df_balance.index]
    other_rows = [r for r in df_balance.index if r not in balance_sheet_order]
    
    final_df = df_balance.reindex(existing_rows + other_rows)
    return final_df

def arrange_cashflow(df_cashflow):
    existing_rows = [r for r in cashflow_order if r in df_cashflow.index]
    other_rows = [r for r in df_cashflow.index if r not in cashflow_order]
    
    final_df = df_cashflow.reindex(existing_rows + other_rows)
    return final_df

