        if len(revenue_data) > 0:
            revenue_data.plot(ax=ax1, marker='o', linewidth=2, color='#2E86AB')
            ax1.set_title('📈 Revenue Trend', fontweight='bold')
            ax1.set_ylabel('Revenue ($M)')
            ax1.grid(True, alpha=0.3)
    
