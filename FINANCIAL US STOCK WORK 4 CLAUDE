# ─────────────────────────────────────────────────────────────────────────────
# VALUATION ENGINE (Buffett-Style DCF)
# ─────────────────────────────────────────────────────────────────────────────

def calculate_intrinsic_value(
    df_inc_a:        pd.DataFrame,
    df_cf_a:         pd.DataFrame,
    overview:        Dict[str, Any],
    treasury_yield:  float,
) -> Dict[str, Any]:
    results: Dict[str, Any] = {}

    if not df_cf_a.empty and len(df_cf_a) >= 3:
        base_fcf = df_cf_a['freeCashFlow'].head(3).mean()
    else:
        base_fcf = 0.0

    if not df_inc_a.empty and '_rev_yoy' in df_inc_a.columns and len(df_inc_a) >= 5:
        growth_rate = df_inc_a['_rev_yoy'].head(5).mean()
        growth_rate = min(max(growth_rate, 0.02), 0.15) 
    else:
        growth_rate = 0.05

    equity_risk_premium = 0.05 
    cost_of_equity = treasury_yield + equity_risk_premium
    discount_rate = cost_of_equity
    terminal_growth_rate = 0.025
    projection_years = 10

    projected_fcf = [base_fcf * ((1 + growth_rate) ** i) for i in range(1, projection_years + 1)]
    discount_factors = [(1 / ((1 + discount_rate) ** i)) for i in range(1, projection_years + 1)]
    pv_fcf = [fcf * df for fcf, df in zip(projected_fcf, discount_factors)]
    sum_pv_fcf = sum(pv_fcf)

    terminal_value = (projected_fcf[-1] * (1 + terminal_growth_rate)) / (discount_rate - terminal_growth_rate)
    pv_terminal_value = terminal_value / ((1 + discount_rate) ** projection_years)
    intrinsic_value = sum_pv_fcf + pv_terminal_value

    results.update({
        "Base FCF (Last 3Y Avg)": base_fcf,
        "Growth Rate (5Y Avg Rev YoY, capped 15%)": growth_rate,
        "10Y Treasury Yield (Risk-Free Rate)": treasury_yield,
        "Equity Risk Premium": equity_risk_premium,
        "Discount Rate (Simplified WACC)": discount_rate,
        "Terminal Growth Rate": terminal_growth_rate,
        "Projected FCF (Sum PV)": sum_pv_fcf,
        "Terminal Value (PV)": pv_terminal_value,
        "Calculated Intrinsic Value": intrinsic_value
    })

    sensitivity_table: Dict[str, Dict[str, float]] = {}
    rate_variations = [-0.01, 0, 0.01] 
    for dr_change in rate_variations:
        sens_dr = discount_rate + dr_change
        if sens_dr <= terminal_growth_rate: sens_dr = terminal_growth_rate + 0.001
        
        sens_pv_fcf = sum([base_fcf * ((1 + growth_rate) ** i) / ((1 + sens_dr) ** i) for i in range(1, projection_years + 1)])
        sens_tv = (base_fcf * ((1 + growth_rate) ** projection_years) * (1 + terminal_growth_rate)) / (sens_dr - terminal_growth_rate)
        sens_pv_tv = sens_tv / ((1 + sens_dr) ** projection_years)
        
        sensitivity_table[f"DR {dr_change:+.0%}"] = {"Intrinsic Value": sens_pv_fcf + sens_pv_tv}

    results["Sensitivity Analysis"] = pd.DataFrame.from_dict(sensitivity_table, orient="index")
    return results


def format_excel_valuation(
    wb:       xlsxwriter.Workbook,
    ws:       Any,
    valuation_results: Dict[str, Any],
    overview: Dict[str, Any],
    fmt:      Dict[str, Any],
) -> None:
    ws.hide_gridlines(2)
    ws.set_zoom(90)

    ws.set_column("A:A", 2)
    ws.set_column("B:B", 40)
    ws.set_column("C:C", 20)

    ws.set_row(0, 20)
    ws.merge_range("B1:C1", "Valuation & DCF Analysis", fmt["sub_hdr"])

    current_row = 2
    ws.set_row(current_row, 18)
    ws.merge_range(current_row, 1, current_row, 2, "Valuation Summary", fmt["val_hdr"])
    current_row += 1

    mkt_cap = float(overview.get("MarketCapitalization", 0) or 0)
    intrinsic_value = valuation_results.get("Calculated Intrinsic Value", 0)
    margin_of_safety = (intrinsic_value - mkt_cap) / mkt_cap if mkt_cap != 0 else 0

    ws.write(current_row, 1, "Current Market Capitalization", fmt["val_lbl"])
    ws.write(current_row, 2, mkt_cap / 1e6, fmt["val_num"])
    current_row += 1

    ws.write(current_row, 1, "Calculated Intrinsic Value", fmt["val_lbl"])
    ws.write(current_row, 2, intrinsic_value / 1e6, fmt["val_num"])
    current_row += 1

    ws.write(current_row, 1, "Margin of Safety", fmt["val_lbl"])
    ws.write(current_row, 2, margin_of_safety, fmt["val_pct"])
    
    # Priority 4: Conditional Coloring for Margin of Safety
    ws.conditional_format(current_row, 2, current_row, 2, {
        'type':     'cell',
        'criteria': '>',
        'value':    0.20,
        'format':   wb.add_format({'bg_color': C["pos_green_fill"], 'font_color': C["pos_green"]})
    })
    ws.conditional_format(current_row, 2, current_row, 2, {
        'type':     'cell',
        'criteria': '<',
        'value':    0,
        'format':   wb.add_format({'bg_color': C["neg_red_fill"], 'font_color': C["neg_red"]})
    })
    
    # Visual Box for Intrinsic Value and Margin of Safety
    ws.conditional_format(current_row - 1, 1, current_row, 2, {'type': 'no_blanks', 'format': fmt["val_box"]})
    current_row += 2

    # DCF Inputs
    ws.set_row(current_row, 18)
    ws.merge_range(current_row, 1, current_row, 2, "DCF Inputs", fmt["val_hdr"])
    current_row += 1

    ws.write(current_row, 1, "Base FCF (Last 3Y Avg, Millions)", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Base FCF (Last 3Y Avg)", 0) / 1e6, fmt["val_num"])
    current_row += 1

    ws.write(current_row, 1, "Growth Rate (5Y Avg Rev YoY, capped 15%)", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Growth Rate (5Y Avg Rev YoY, capped 15%)", 0), fmt["val_pct"])
    current_row += 1

    ws.write(current_row, 1, "Discount Rate (Simplified WACC)", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Discount Rate (Simplified WACC)", 0), fmt["val_pct"])
    current_row += 2

    # Sensitivity Analysis Table with Heatmap
    sensitivity_df = valuation_results.get("Sensitivity Analysis")
    if sensitivity_df is not None and not sensitivity_df.empty:
        ws.set_row(current_row, 18)
        ws.merge_range(current_row, 1, current_row, 2 + len(sensitivity_df.index) - 1, "Intrinsic Value Sensitivity (Millions)", fmt["val_hdr"])
        current_row += 1

        ws.write(current_row, 1, "Discount Rate Change", fmt["val_sens_hdr"])
        for i, dr_label in enumerate(sensitivity_df.index):
            ws.write(current_row, 2 + i, dr_label, fmt["val_sens_hdr"])
        current_row += 1

        ws.write(current_row, 1, "Intrinsic Value", fmt["val_sens_lbl"])
        for i, dr_label in enumerate(sensitivity_df.index):
            ws.write(current_row, 2 + i, sensitivity_df.loc[dr_label, "Intrinsic Value"] / 1e6, fmt["val_sens_num"])
        
        # Heatmap formatting
        ws.conditional_format(current_row, 2, current_row, 2 + len(sensitivity_df.index) - 1, {
            'type': '3_color_scale',
            'min_color': C["neg_red_fill"],
            'mid_color': C["neutral_fill"],
            'max_color': C["pos_green_fill"]
        })


