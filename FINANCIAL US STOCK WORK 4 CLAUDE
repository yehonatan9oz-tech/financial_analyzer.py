def fetch_api_data(url: str, label: str) -> Optional[Dict[str, Any]]:
    try:
        resp = requests.get(url, timeout=30)
        resp.raise_for_status()
        data: Dict[str, Any] = resp.json()

        if "Error Message" in data:
            print(f"  [ERROR]      {label}: {data['Error Message']}")
            return None
        if "Note" in data:
            print(f"  [RATE LIMIT] {label}: API call frequency exceeded.")
            print("  Upgrade to a paid Alpha Vantage plan or wait 60 s.")
            return None
        if "Information" in data:
            print(f"  [INFO]       {label}: {data['Information']}")
            return None
        return data

    except requests.exceptions.Timeout:
        print(f"  [TIMEOUT]    {label}")
        return None
    except requests.exceptions.RequestException as exc:
        print(f"  [ERROR]      {label}: {exc}")
        return None

def fetch_treasury_yield(api_key: str) -> Optional[float]:
    url = f"{API_BASE_URL}?function=TREASURY_YIELD&interval=daily&maturity=10year&apikey={api_key}"
    data = fetch_api_data(url, "10-Year Treasury Yield")
    if data and "data" in data and data["data"]:
        # Get the latest yield
        latest_yield = float(data["data"][0]["value"])
        return latest_yield / 100 # Convert to decimal
    return None

def fetch_all_financial_data(ticker: str, api_key: str) -> Dict[str, Any]:
    endpoints = [
        ("income",   f"{API_BASE_URL}?function=INCOME_STATEMENT&symbol={ticker}&apikey={api_key}"),
        ("balance",  f"{API_BASE_URL}?function=BALANCE_SHEET&symbol={ticker}&apikey={api_key}"),
        ("cashflow", f"{API_BASE_URL}?function=CASH_FLOW&symbol={ticker}&apikey={api_key}"),
        ("overview", f"{API_BASE_URL}?function=OVERVIEW&symbol={ticker}&apikey={api_key}"),
    ]

    results: Dict[str, Any] = {}
    for label, url in endpoints:
        print(f"  Fetching {label}...")
        data = fetch_api_data(url, label)
        if data:
            results[label] = data
        time.sleep(API_DELAY_SEC)
    return results


def process_raw_reports(reports: List[Dict[str, Any]]) -> pd.DataFrame:
    processed_data: Dict[str, Dict[str, float]] = {}
    for report in reports:
        fiscal_date = report.get("fiscalDateEnding")
        if not fiscal_date: continue

        processed_data[fiscal_date] = {
            k: float(v) if isinstance(v, (int, float, str)) and str(v).replace('.', '', 1).isdigit() else 0.0
            for k, v in report.items() if k != "fiscalDateEnding"
        }

    df = pd.DataFrame.from_dict(processed_data, orient="index")
    df.index = pd.to_datetime(df.index)
    df = df.sort_index(ascending=False)
    return df


def calculate_financial_metrics(
    df_inc: pd.DataFrame,
    df_bal: pd.DataFrame,
    df_cf:  pd.DataFrame,
) -> Tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame]:

    # --- Income Statement --- #
    if not df_inc.empty:
        df_inc["_gross_margin"] = df_inc["grossProfit"] / df_inc["totalRevenue"]
        df_inc["_operating_margin"] = df_inc["operatingIncome"] / df_inc["totalRevenue"]
        df_inc["_net_margin"] = df_inc["netIncome"] / df_inc["totalRevenue"]

        # YoY Growth (Current / Previous - 1)
        # Since index is sorted descending (latest first), pct_change(periods=-1) gives (latest - previous) / previous
        df_inc["_rev_yoy"] = df_inc["totalRevenue"].pct_change(periods=-1)
        df_inc["_opinc_yoy"] = df_inc["operatingIncome"].pct_change(periods=-1)
        df_inc["_ni_yoy"] = df_inc["netIncome"].pct_change(periods=-1)

    # --- Cash Flow Statement --- #
    if not df_cf.empty:
        df_cf["freeCashFlow"] = df_cf["operatingCashflow"] - df_cf["capitalExpenditures"]
        if not df_inc.empty:
            df_cf["_fcf_margin"] = df_cf["freeCashFlow"] / df_inc["totalRevenue"]

    # --- Balance Sheet --- #
    if not df_bal.empty:
        df_bal["shortLongTermDebtTotal"] = df_bal["shortTermDebt"] + df_bal["longTermDebt"]

    return df_inc, df_bal, df_cf


def calculate_valuation_metrics(
    df_inc:   pd.DataFrame,
    df_bal:   pd.DataFrame,
    df_cf:    pd.DataFrame,
    overview: Dict[str, Any],
) -> pd.DataFrame:
    ratios_data: Dict[str, Dict[str, float]] = {}

    mkt_cap = float(overview.get("MarketCapitalization", 0) or 0)
    enterprise_value = float(overview.get("EnterpriseValue", 0) or 0)

    for date in df_inc.index:
        date_str = str(date)[:10]
        ratios_data[date_str] = {}

        # Profitability
        ratios_data[date_str]["Gross Margin %"] = df_inc.loc[date, "_gross_margin"]
        ratios_data[date_str]["Operating Margin %"] = df_inc.loc[date, "_operating_margin"]
        ratios_data[date_str]["Net Margin %"] = df_inc.loc[date, "_net_margin"]
        ratios_data[date_str]["EBITDA Margin %"] = (
            df_inc.loc[date, "ebitda"] / df_inc.loc[date, "totalRevenue"]
            if df_inc.loc[date, "totalRevenue"] != 0 else 0
        )
        if date in df_cf.index:
            ratios_data[date_str]["FCF Margin %"] = df_cf.loc[date, "_fcf_margin"]

        # Capital Efficiency
        if date in df_bal.index:
            invested_capital = df_bal.loc[date, "totalShareholderEquity"] + df_bal.loc[date, "shortLongTermDebtTotal"]
            ratios_data[date_str]["ROIC %  (NOPAT / Invested Capital)"] = (
                df_inc.loc[date, "netIncome"] / invested_capital
                if invested_capital != 0 else 0
            )
            ratios_data[date_str]["ROE %  (Net Income / Equity)"] = (
                df_inc.loc[date, "netIncome"] / df_bal.loc[date, "totalShareholderEquity"]
                if df_bal.loc[date, "totalShareholderEquity"] != 0 else 0
            )
            ratios_data[date_str]["ROA %  (Net Income / Total Assets)"] = (
                df_inc.loc[date, "netIncome"] / df_bal.loc[date, "totalAssets"]
                if df_bal.loc[date, "totalAssets"] != 0 else 0
            )
            capital_employed = df_bal.loc[date, "totalAssets"] - df_bal.loc[date, "totalCurrentLiabilities"]
            ratios_data[date_str]["ROCE %  (EBIT / Capital Employed)"] = (
                df_inc.loc[date, "operatingIncome"] / capital_employed
                if capital_employed != 0 else 0
            )

            # Liquidity
            ratios_data[date_str]["Current Ratio"] = (
                df_bal.loc[date, "totalCurrentAssets"] / df_bal.loc[date, "totalCurrentLiabilities"]
                if df_bal.loc[date, "totalCurrentLiabilities"] != 0 else 0
            )
            ratios_data[date_str]["Quick Ratio"] = (
                (df_bal.loc[date, "cashAndCashEquivalentsAtCarryingValue"] + df_bal.loc[date, "currentNetReceivables"]) /
                df_bal.loc[date, "totalCurrentLiabilities"]
                if df_bal.loc[date, "totalCurrentLiabilities"] != 0 else 0
            )

            # Leverage & Coverage
            ratios_data[date_str]["Debt / Equity"] = (
                df_bal.loc[date, "shortLongTermDebtTotal"] / df_bal.loc[date, "totalShareholderEquity"]
                if df_bal.loc[date, "totalShareholderEquity"] != 0 else 0
            )
            ratios_data[date_str]["Net Debt / EBITDA"] = (
                (df_bal.loc[date, "shortLongTermDebtTotal"] - df_bal.loc[date, "cashAndCashEquivalentsAtCarryingValue"]) /
                df_inc.loc[date, "ebitda"]
                if df_inc.loc[date, "ebitda"] != 0 else 0
            )
            ratios_data[date_str]["Interest Coverage (x)"] = (
                df_inc.loc[date, "ebitda"] / df_inc.loc[date, "interestExpense"]
                if df_inc.loc[date, "interestExpense"] != 0 else 0
            )

        # Cash Flow Quality
        if date in df_cf.index:
            ratios_data[date_str]["CFO / Net Income"] = (
                df_cf.loc[date, "operatingCashflow"] / df_inc.loc[date, "netIncome"]
                if df_inc.loc[date, "netIncome"] != 0 else 0
            )
            ratios_data[date_str]["FCF / CFO"] = (
                df_cf.loc[date, "freeCashFlow"] / df_cf.loc[date, "operatingCashflow"]
                if df_cf.loc[date, "operatingCashflow"] != 0 else 0
            )
            ratios_data[date_str]["FCF Yield %  [vs. Current Mkt Cap]"] = (
                df_cf.loc[date, "freeCashFlow"] / mkt_cap
                if mkt_cap != 0 else 0
            )

        # Valuation
        ratios_data[date_str]["P/E  [Curr. Mkt Cap / Hist. Net Income]"] = (
            mkt_cap / df_inc.loc[date, "netIncome"]
            if df_inc.loc[date, "netIncome"] != 0 else 0
        )
        ratios_data[date_str]["P/S  [Curr. Mkt Cap / Hist. Revenue]"] = (
            mkt_cap / df_inc.loc[date, "totalRevenue"]
            if df_inc.loc[date, "totalRevenue"] != 0 else 0
        )
        if date in df_bal.index:
            ratios_data[date_str]["P/B  [Curr. Mkt Cap / Hist. Book Value]"] = (
                mkt_cap / df_bal.loc[date, "totalShareholderEquity"]
                if df_bal.loc[date, "totalShareholderEquity"] != 0 else 0
            )
        ratios_data[date_str]["EV/EBITDA  [Curr. EV / Hist. EBITDA]"] = (
            enterprise_value / df_inc.loc[date, "ebitda"]
            if df_inc.loc[date, "ebitda"] != 0 else 0
        )

    ratios_df = pd.DataFrame.from_dict(ratios_data, orient="index")
    return ratios_df


def build_labeled_df(df: pd.DataFrame, order: List[str], labels: Dict[str, str]) -> pd.DataFrame:
    display_rows = []
    for item in order:
        if item in df.columns:
            display_rows.append(df.loc[:, item].rename(labels.get(item, item)))
    return pd.DataFrame(display_rows)


