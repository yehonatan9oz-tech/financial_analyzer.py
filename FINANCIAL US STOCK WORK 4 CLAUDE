def main() -> None:
    print("=" * 65)
    print("  Investment Bank Grade Financial Analyzer V4")
    print("  Powered by Alpha Vantage                     (free tier: 5 rpm)")
    print("=" * 65)

    ticker  = input("\nEnter stock symbol (e.g., MSFT, AAPL, GOOGL): ").strip().upper()
    api_key = input("Enter your Alpha Vantage API key              : ").strip()

    if not ticker or not api_key:
        print("[FATAL] Ticker and API key are required.")
        sys.exit(1)

    print(f"\nFetching financial data for {ticker}...")
    raw = fetch_all_financial_data(ticker, api_key)
    treasury_yield = fetch_treasury_yield(api_key) or 0.04

    income_raw   = raw.get("income")   or {}
    balance_raw  = raw.get("balance")  or {}
    cashflow_raw = raw.get("cashflow") or {}
    overview     = raw.get("overview") or {}

    if not income_raw or "annualReports" not in income_raw:
        print("\n[FATAL] Could not retrieve income statement data.")
        sys.exit(1)

    print("\nProcessing financial statements...")
    df_inc_a = process_raw_reports(income_raw.get("annualReports", []))
    df_bal_a = process_raw_reports(balance_raw.get("annualReports", []))
    df_cf_a  = process_raw_reports(cashflow_raw.get("annualReports", []))
    df_inc_q = process_raw_reports(income_raw.get("quarterlyReports", [])[:8])
    df_bal_q = process_raw_reports(balance_raw.get("quarterlyReports", [])[:8])
    df_cf_q  = process_raw_reports(cashflow_raw.get("quarterlyReports", [])[:8])

    print("Calculating metrics and ratios...")
    df_inc_a, df_bal_a, df_cf_a = calculate_financial_metrics(df_inc_a, df_bal_a, df_cf_a)
    df_inc_q, df_bal_q, df_cf_q = calculate_financial_metrics(df_inc_q, df_bal_q, df_cf_q)
    ratios_df = calculate_valuation_metrics(df_inc_a, df_bal_a, df_cf_a, overview)
    valuation_results = calculate_intrinsic_value(df_inc_a, df_cf_a, overview, treasury_yield)

    print("Preparing display structures...")
    inc_a_disp = build_labeled_df(df_inc_a, _INCOME_ORDER, _INCOME_LABELS)
    inc_q_disp = build_labeled_df(df_inc_q, _INCOME_ORDER, _INCOME_LABELS)
    cf_a_disp  = build_labeled_df(df_cf_a,  _CF_ORDER,     _CF_LABELS)
    cf_q_disp  = build_labeled_df(df_cf_q,  _CF_ORDER,     _CF_LABELS)
    bs_a_disp  = build_labeled_df(df_bal_a, _BS_ORDER,     _BS_LABELS)
    bs_q_disp  = build_labeled_df(df_bal_q, _BS_ORDER,     _BS_LABELS)

    output_file = f"{ticker}_IB_Financial_Report_V4.xlsx"
    print(f"\nGenerating Excel workbook: {output_file}...")

    wb = xlsxwriter.Workbook(output_file, {"strings_to_numbers": False, "nan_inf_to_errors": True})
    fmt = _build_formats(wb)

    worksheets = {name: wb.add_worksheet(name) for name in [
        "Dashboard", "Annual · Income Stmt", "Annual · Balance Sheet", "Annual · Cash Flow",
        "Qtrly · Income Stmt", "Qtrly · Balance Sheet", "Qtrly · Cash Flow", "Financial Ratios", "Valuation & DCF"
    ]}

    format_excel_dashboard(wb, worksheets["Dashboard"], ticker, overview, df_inc_a, df_cf_a, ratios_df, fmt)
    add_professional_charts(wb, worksheets["Dashboard"], df_inc_a, df_cf_a, ratios_df, fmt)

    format_excel_financials(wb, worksheets["Annual · Income Stmt"], inc_a_disp, fmt, f"{ticker} - Annual Income Statement")
    format_excel_financials(wb, worksheets["Annual · Balance Sheet"], bs_a_disp, fmt, f"{ticker} - Annual Balance Sheet")
    format_excel_financials(wb, worksheets["Annual · Cash Flow"], cf_a_disp, fmt, f"{ticker} - Annual Cash Flow")
    format_excel_financials(wb, worksheets["Qtrly · Income Stmt"], inc_q_disp, fmt, f"{ticker} - Quarterly Income Statement")
    format_excel_financials(wb, worksheets["Qtrly · Balance Sheet"], bs_q_disp, fmt, f"{ticker} - Quarterly Balance Sheet")
    format_excel_financials(wb, worksheets["Qtrly · Cash Flow"], cf_q_disp, fmt, f"{ticker} - Quarterly Cash Flow")

    format_excel_ratios(wb, worksheets["Financial Ratios"], ratios_df, fmt)
    format_excel_valuation(wb, worksheets["Valuation & DCF"], valuation_results, overview, fmt)

    wb.close()
    print(f"\nSUCCESS — Report saved to: {output_file}")

if __name__ == "__main__":
    main()
