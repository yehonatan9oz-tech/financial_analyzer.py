def format_excel_ratios(
    wb:     xlsxwriter.Workbook,
    ws:     Any,
    ratios: pd.DataFrame,
    fmt:    Dict[str, Any],
) -> None:
    ws.hide_gridlines(2)
    ws.freeze_panes(2, 1)
    ws.set_zoom(90)

    n_periods = len(ratios.index)
    ws.set_column(0, 0, 52)
    for c in range(n_periods):
        ws.set_column(c + 1, c + 1, 18)

    ws.set_row(0, 20)
    ws.merge_range(0, 0, 0, n_periods, "Financial Ratios & Valuation Metrics", fmt["sub_hdr"])
    ws.set_row(1, 18)
    ws.write(1, 0, "Metric", fmt["col_hdr"])
    for ci, period in enumerate(ratios.index):
        ws.write(1, ci + 1, str(period)[:10], fmt["col_hdr"])

    _PCT  = {"margin", "yield", "roe", "roa", "roic", "roce", "fcf %", "yield %"}
    _MULT = {"p/e", "p/s", "p/b", "ev/ebitda", "coverage", "cfo /", "fcf / cfo"}

    def _num_fmt(metric: str) -> Any:
        ml = metric.lower()
        if any(k in ml for k in _PCT) or "%" in metric:
            return fmt["ratio_pct"]
        if any(k in ml for k in _MULT):
            return fmt["ratio_mult"]
        return fmt["ratio_num"]

    current_row = 2
    for section, metrics in _RATIO_CATEGORIES.items():
        ws.set_row(current_row, 18)
        ws.merge_range(current_row, 0, current_row, n_periods, section, fmt["ratio_sec"])
        current_row += 1

        for metric in metrics:
            ws.set_row(current_row, 16)
            ws.write(current_row, 0, metric, fmt["ratio_lbl"])
            nf = _num_fmt(metric)
            for ci, period in enumerate(ratios.index):
                if metric in ratios.columns:
                    val = ratios.at[period, metric]
                    if val is None or (isinstance(val, float) and (pd.isna(val) or abs(val) == float("inf"))):
                        ws.write(current_row, ci + 1, "—", nf)
                    else:
                        ws.write(current_row, ci + 1, float(val), nf)
                else:
                    ws.write(current_row, ci + 1, "—", nf)
            current_row += 1

    # Banding for alternating row colors
    for row_num in range(2, current_row):
        if row_num % 2 == 0:
            ws.set_row(row_num, None, wb.add_format({'bg_color': C["pale_blue"]}))

    # Conditional formatting for ROIC > 15%
    roic_row_label = "ROIC %  (NOPAT / Invested Capital)"
    roic_row_in_excel = -1
    current_excel_row = 2
    for section, metrics in _RATIO_CATEGORIES.items():
        current_excel_row += 1 # For section header
        for metric in metrics:
            if metric == roic_row_label:
                roic_row_in_excel = current_excel_row
                break
            current_excel_row += 1
        if roic_row_in_excel != -1:
            break

    if roic_row_in_excel != -1:
        ws.conditional_format(
            roic_row_in_excel, 1, roic_row_in_excel, n_periods,
            {
                'type':     'cell',
                'criteria': '>',
                'value':    0.15,
                'format':   wb.add_format({'bg_color': C["pos_green_fill"], 'font_color': C["pos_green"]})
            }
        )


