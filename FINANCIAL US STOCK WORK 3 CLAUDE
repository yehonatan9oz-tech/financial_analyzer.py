# ROW CLASSIFICATION HELPERS
# ─────────────────────────────────────────────────────────────────────────────

def _row_type(label: str) -> str:
    if label in _KEY_METRICS:
        return "key"
    lw = label.lower()
    if "yoy" in lw:
        return "yoy"
    if "margin %" in lw:
        return "pct"
    spaces = len(label) - len(label.lstrip())
    if spaces >= 4:
        return "indent2"
    if spaces >= 2:
        return "indent1"
    return "standard"


def _group_level(label: str) -> int:
    spaces = len(label) - len(label.lstrip())
    if spaces >= 4:
        return 2
    if spaces >= 2:
        return 1
    return 0


