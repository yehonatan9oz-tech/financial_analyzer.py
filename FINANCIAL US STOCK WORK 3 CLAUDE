def main() -> None:
    print("=" * 65)
    print("  Investment Bank Grade Financial Analyzer")
    print("  Powered by Alpha Vantage                     (free tier: 5 rpm)")
    print("=" * 65)

    ticker  = input("\nEnter stock symbol (e.g., MSFT, AAPL, GOOGL): ").strip().upper()
    api_key = input("Enter your Alpha Vantage API key              : ").strip()

    if not ticker or not api_key:
        print("[FATAL] Ticker and API key are required.")
        sys.exit(1)

    print(f"\nFetching financial data for {ticker} "
          f"({API_DELAY_SEC}s delay between API calls)...\n")
    raw = fetch_all_financial_data(ticker, api_key)
    treasury_yield = fetch_treasury_yield(api_key)
    if treasury_yield is None:
        print("[WARNING] Could not fetch 10-Year Treasury Yield. Using default 0.03 (3%).")
        treasury_yield = 0.03 # Default to 3% if API fails

    income_raw   = raw.get("income")   or {}
    balance_raw  = raw.get("balance")  or {}
    cashflow_raw = raw.get("cashflow") or {}
    overview     = raw.get("overview") or {}

    if not income_raw or "annualReports" not in income_raw:
        print("\n[FATAL] Could not retrieve income statement data.")
        print("  Check: ticker validity, API key, and rate-limit status.")
        sys.exit(1)

    # 2. Process raw reports
    print("\nProcessing financial statements...")
    df_inc_a = process_raw_reports(income_raw  .get("annualReports",    []))
    df_bal_a = process_raw_reports(balance_raw .get("annualReports",    []))
    df_cf_a  = process_raw_reports(cashflow_raw.get("annualReports",    []))
    df_inc_q = process_raw_reports(income_raw  .get("quarterlyReports", [])[:8])
    df_bal_q = process_raw_reports(balance_raw .get("quarterlyReports", [])[:8])
    df_cf_q  = process_raw_reports(cashflow_raw.get("quarterlyReports", [])[:8])

    # 3. Derive metrics
    print("Calculating FCF, EPS, margins, and YoY growth rates...")
    df_inc_a, df_bal_a, df_cf_a = calculate_financial_metrics(df_inc_a, df_bal_a, df_cf_a)
    df_inc_q, df_bal_q, df_cf_q = calculate_financial_metrics(df_inc_q, df_bal_q, df_cf_q)

    # 4. Valuation ratios
    print("Computing valuation and capital-efficiency ratios...")
    ratios_df = calculate_valuation_metrics(df_inc_a, df_bal_a, df_cf_a, overview)

    # 5. Calculate Intrinsic Value
    print("Calculating Intrinsic Value (Buffett-Style DCF)...")
    valuation_results = calculate_intrinsic_value(df_inc_a, df_cf_a, overview, treasury_yield)

    # 6. Build display DataFrames
    print("Preparing display structures...")
    inc_a_disp = build_labeled_df(df_inc_a, _INCOME_ORDER, _INCOME_LABELS)
    inc_q_disp = build_labeled_df(df_inc_q, _INCOME_ORDER, _INCOME_LABELS)
    cf_a_disp  = build_labeled_df(df_cf_a,  _CF_ORDER,     _CF_LABELS)
    cf_q_disp  = build_labeled_df(df_cf_q,  _CF_ORDER,     _CF_LABELS)
    bs_a_disp  = build_labeled_df(df_bal_a, _BS_ORDER,     _BS_LABELS)
    bs_q_disp  = build_labeled_df(df_bal_q, _BS_ORDER,     _BS_LABELS)

    # 7. Build Excel workbook
    output_file = f"{ticker}_IB_Financial_Report_V3.xlsx"
    print(f"\nGenerating Excel workbook: {output_file} ...")

    wb = xlsxwriter.Workbook(
        output_file,
        {"strings_to_numbers": False, "nan_inf_to_errors": True},
    )
    fmt = _build_formats(wb)

    sheet_specs = [
        ("Dashboard",              None,       ""),
        ("Annual · Income Stmt",   inc_a_disp, f"{ticker}  —  Annual Income Statement  (USD Millions)"),
        ("Annual · Balance Sheet", bs_a_disp,  f"{ticker}  —  Annual Balance Sheet  (USD Millions)"),
        ("Annual · Cash Flow",     cf_a_disp,  f"{ticker}  —  Annual Cash Flow Statement  (USD Millions)"),
        ("Qtrly · Income Stmt",    inc_q_disp, f"{ticker}  —  Quarterly Income Statement  (USD Millions)"),
        ("Qtrly · Balance Sheet",  bs_q_disp,  f"{ticker}  —  Quarterly Balance Sheet  (USD Millions)"),
        ("Qtrly · Cash Flow",      cf_q_disp,  f"{ticker}  —  Quarterly Cash Flow Statement  (USD Millions)"),
        ("Financial Ratios",       None,       ""),
        ("Valuation & DCF",        None,       ""), # New sheet
    ]

    worksheets: Dict[str, Any] = {}
    for name, _, _ in sheet_specs:
        worksheets[name] = wb.add_worksheet(name)

    format_excel_dashboard(
        wb, worksheets["Dashboard"], ticker, overview,
        df_inc_a, df_cf_a, fmt,
    )
    add_professional_charts(
        wb, worksheets["Dashboard"], df_inc_a, df_cf_a, ratios, fmt,
    )

    for sname, df_disp, title in sheet_specs[1:-2]: # Exclude Dashboard and new Valuation sheet
        ws = worksheets[sname]
        if df_disp is not None and not df_disp.empty:
            format_excel_financials(wb, ws, df_disp, fmt, title)

    if not ratios_df.empty:
        format_excel_ratios(wb, worksheets["Financial Ratios"], ratios_df, fmt)

    format_excel_valuation(
        wb, worksheets["Valuation & DCF"], valuation_results, overview, fmt,
    )

    wb.close()

    print(f"\n{'=' * 65}")
    print(f"  SUCCESS  —  Report saved to: {output_file}")
    print(f"  Sheets  : Dashboard | 3x Annual | 3x Quarterly | Financial Ratios | Valuation & DCF")
    print(f"{'=' * 65}\n")


if __name__ == "__main__":
    main()
