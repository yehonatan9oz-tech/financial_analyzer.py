# ─────────────────────────────────────────────────────────────────────────────
# VALUATION ENGINE (Buffett-Style DCF)
# ─────────────────────────────────────────────────────────────────────────────

def calculate_intrinsic_value(
    df_inc_a:        pd.DataFrame,
    df_cf_a:         pd.DataFrame,
    overview:        Dict[str, Any],
    treasury_yield:  float,
) -> Dict[str, Any]:
    results: Dict[str, Any] = {}

    # Base FCF: Average Free Cash Flow from the last 3 years
    if not df_cf_a.empty and len(df_cf_a) >= 3:
        base_fcf = df_cf_a['freeCashFlow'].head(3).mean()
    else:
        base_fcf = 0.0

    # Growth Rate: 5-year average Revenue YoY growth (capped at 15%)
    if not df_inc_a.empty and '_rev_yoy' in df_inc_a.columns and len(df_inc_a) >= 5:
        growth_rate = df_inc_a['_rev_yoy'].head(5).mean()
        growth_rate = min(growth_rate, 0.15) # Cap at 15% for conservatism
    else:
        growth_rate = 0.05 # Default to 5% if not enough data

    # Discount Rate (WACC): Simplified WACC where Cost of Equity = 10Y Treasury Yield + 5% Equity Risk Premium
    equity_risk_premium = 0.05 # 5% Equity Risk Premium
    cost_of_equity = treasury_yield + equity_risk_premium
    # For simplicity, assuming WACC = Cost of Equity for this Buffett-style DCF
    # In a full model, one would also consider Cost of Debt and Debt/Equity ratio
    discount_rate = cost_of_equity

    # Terminal Growth Rate (conservative, e.g., 2.5%)
    terminal_growth_rate = 0.025

    # Projection Period (e.g., 10 years)
    projection_years = 10

    # DCF Calculation
    projected_fcf = [base_fcf * ((1 + growth_rate) ** i) for i in range(1, projection_years + 1)]
    discount_factors = [(1 / ((1 + discount_rate) ** i)) for i in range(1, projection_years + 1)]
    pv_fcf = [fcf * df for fcf, df in zip(projected_fcf, discount_factors)]

    sum_pv_fcf = sum(pv_fcf)

    # Terminal Value
    terminal_value = (projected_fcf[-1] * (1 + terminal_growth_rate)) / (discount_rate - terminal_growth_rate)
    pv_terminal_value = terminal_value / ((1 + discount_rate) ** projection_years)

    intrinsic_value = sum_pv_fcf + pv_terminal_value

    results["Base FCF (Last 3Y Avg)"] = base_fcf
    results["Growth Rate (5Y Avg Rev YoY, capped 15%)"] = growth_rate
    results["10Y Treasury Yield (Risk-Free Rate)"] = treasury_yield
    results["Equity Risk Premium"] = equity_risk_premium
    results["Discount Rate (Simplified WACC)"] = discount_rate
    results["Terminal Growth Rate"] = terminal_growth_rate
    results["Projected FCF (Sum PV)"] = sum_pv_fcf
    results["Terminal Value (PV)"] = pv_terminal_value
    results["Calculated Intrinsic Value"] = intrinsic_value

    # Sensitivity Analysis
    sensitivity_table: Dict[str, Dict[str, float]] = {}
    rate_variations = [-0.01, 0, 0.01] # -1%, 0%, +1% change in discount rate
    for i, dr_change in enumerate(rate_variations):
        sens_discount_rate = discount_rate + dr_change
        if sens_discount_rate <= terminal_growth_rate: # Avoid division by zero or negative denominator
            sens_discount_rate = terminal_growth_rate + 0.001 # Small increment

        sens_projected_fcf = [base_fcf * ((1 + growth_rate) ** i) for i in range(1, projection_years + 1)]
        sens_discount_factors = [(1 / ((1 + sens_discount_rate) ** i)) for i in range(1, projection_years + 1)]
        sens_pv_fcf = [fcf * df for fcf, df in zip(sens_projected_fcf, sens_discount_factors)]
        sens_sum_pv_fcf = sum(sens_pv_fcf)

        sens_terminal_value = (sens_projected_fcf[-1] * (1 + terminal_growth_rate)) / (sens_discount_rate - terminal_growth_rate)
        sens_pv_terminal_value = sens_terminal_value / ((1 + sens_discount_rate) ** projection_years)

        sens_intrinsic_value = sens_sum_pv_fcf + sens_pv_terminal_value
        sensitivity_table[f"DR {dr_change:+.0%}"] = {"Intrinsic Value": sens_intrinsic_value}

    results["Sensitivity Analysis"] = pd.DataFrame.from_dict(sensitivity_table, orient="index")

    return results


def format_excel_valuation(
    wb:       xlsxwriter.Workbook,
