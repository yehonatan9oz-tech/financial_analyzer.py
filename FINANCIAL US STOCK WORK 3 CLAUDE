def format_excel_financials(
    wb:    xlsxwriter.Workbook,
    ws:    Any,
    df:    pd.DataFrame,
    fmt:   Dict[str, Any],
    title: str,
) -> None:
    ws.hide_gridlines(2)
    ws.freeze_panes(2, 1)
    ws.set_zoom(90)

    n_cols = len(df.columns)
    ws.set_column(0, 0, 44)
    for c in range(n_cols):
        ws.set_column(c + 1, c + 1, 16)

    ws.set_row(0, 20)
    ws.merge_range(0, 0, 0, n_cols, title, fmt["sub_hdr"])

    ws.set_row(1, 18)
    ws.write(1, 0, "USD Millions  (except per-share & ratio rows)", fmt["col_hdr"])
    for ci, col_date in enumerate(df.columns):
        ws.write(1, ci + 1, str(col_date)[:10], fmt["col_hdr"])

    yoy_excel_rows: List[int] = []

    for ri, (label, row_data) in enumerate(df.iterrows()):
        excel_row  = ri + 2
        rtype      = _row_type(str(label))
        lvl        = _group_level(str(label))

        if rtype == "key":
            lf, nf, row_h = fmt["key_lbl"],    fmt["key_num"],  18
            lvl = 0
        elif rtype == "pct":
            lf, nf, row_h = fmt["pct_lbl"],    fmt["pct_num"],  15
            lvl = max(lvl, 1)
        elif rtype == "yoy":
            lf, nf, row_h = fmt["yoy_lbl"],    fmt["yoy_num"],  15
            lvl = max(lvl, 1)
            yoy_excel_rows.append(excel_row)
        elif rtype == "indent2":
            lf, nf, row_h = fmt["std_lbl_i2"], fmt["std_num"],  15
        elif rtype == "indent1":
            lf, nf, row_h = fmt["std_lbl_i1"], fmt["std_num"],  15
        else:
            lf, nf, row_h = fmt["std_lbl"],    fmt["std_num"],  16
            lvl = 0

        row_opts = {"level": lvl} if lvl > 0 else {}
        ws.set_row(excel_row, row_h, None, row_opts)
        ws.write(excel_row, 0, str(label), lf)

        for ci, val in enumerate(row_data):
            if pd.isna(val) or val in (float("inf"), float("-inf")):
                ws.write_blank(excel_row, ci + 1, None, nf)
            else:
                ws.write(excel_row, ci + 1, float(val), nf)

    if yoy_excel_rows and n_cols > 1:
        for yr in yoy_excel_rows:
            ws.conditional_format(
                yr, 1, yr, n_cols,
                {
                    "type":      "3_color_scale",
                    "min_color": C["neg_red_fill"],
                    "mid_color": C["neutral_fill"],
                    "max_color": C["pos_green_fill"],
                    "min_type":  "percentile", "min_value": 10,
                    "mid_type":  "percentile", "mid_value": 50,
                    "max_type":  "percentile", "max_value": 90,
                },
            )


