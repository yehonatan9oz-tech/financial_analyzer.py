    # Summary Table
    ws.set_row(current_row, 18)
    ws.merge_range(current_row, 1, current_row, 2, "Valuation Summary", fmt["val_hdr"])
    current_row += 1

    mkt_cap = float(overview.get("MarketCapitalization", 0) or 0)
    intrinsic_value = valuation_results.get("Calculated Intrinsic Value", 0)
    margin_of_safety = (intrinsic_value - mkt_cap) / mkt_cap if mkt_cap != 0 else 0

    ws.write(current_row, 1, "Current Market Capitalization", fmt["val_lbl"])
    ws.write(current_row, 2, mkt_cap, fmt["val_num"])
    current_row += 1

    ws.write(current_row, 1, "Calculated Intrinsic Value", fmt["val_lbl"])
    ws.write(current_row, 2, intrinsic_value, fmt["val_num"])
    current_row += 1

    ws.write(current_row, 1, "Margin of Safety", fmt["val_lbl"])
    ws.write(current_row, 2, margin_of_safety, fmt["val_pct"])
    current_row += 2

    # DCF Inputs
    ws.set_row(current_row, 18)
    ws.merge_range(current_row, 1, current_row, 2, "DCF Inputs", fmt["val_hdr"])
    current_row += 1

    ws.write(current_row, 1, "Base FCF (Last 3Y Avg)", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Base FCF (Last 3Y Avg)", 0), fmt["val_num"])
    current_row += 1

    ws.write(current_row, 1, "Growth Rate (5Y Avg Rev YoY, capped 15%)", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Growth Rate (5Y Avg Rev YoY, capped 15%)", 0), fmt["val_pct"])
    current_row += 1

    ws.write(current_row, 1, "10Y Treasury Yield (Risk-Free Rate)", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("10Y Treasury Yield (Risk-Free Rate)", 0), fmt["val_pct"])
    current_row += 1

    ws.write(current_row, 1, "Equity Risk Premium", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Equity Risk Premium", 0), fmt["val_pct"])
    current_row += 1

    ws.write(current_row, 1, "Discount Rate (Simplified WACC)", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Discount Rate (Simplified WACC)", 0), fmt["val_pct"])
    current_row += 1

    ws.write(current_row, 1, "Terminal Growth Rate", fmt["val_lbl"])
    ws.write(current_row, 2, valuation_results.get("Terminal Growth Rate", 0), fmt["val_pct"])
    current_row += 2

    # Sensitivity Analysis Table
    sensitivity_df = valuation_results.get("Sensitivity Analysis")
    if sensitivity_df is not None and not sensitivity_df.empty:
        ws.set_row(current_row, 18)
        ws.merge_range(current_row, 1, current_row, 2 + len(sensitivity_df.index) -1, "Intrinsic Value Sensitivity to Discount Rate", fmt["val_hdr"])
        current_row += 1

        # Write headers
        ws.write(current_row, 1, "Discount Rate Change", fmt["val_sens_hdr"])
        col_offset = 2
        for dr_label in sensitivity_df.index:
            ws.write(current_row, col_offset, dr_label, fmt["val_sens_hdr"])
            col_offset += 1
        current_row += 1

        # Write data
        ws.write(current_row, 1, "Intrinsic Value", fmt["val_sens_lbl"])
        col_offset = 2
        for dr_label in sensitivity_df.index:
            ws.write(current_row, col_offset, sensitivity_df.loc[dr_label, "Intrinsic Value"], fmt["val_sens_num"])
            col_offset += 1
        current_row += 1


